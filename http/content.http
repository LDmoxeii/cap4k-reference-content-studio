@baseUrl = http://localhost:8080
@contentId =
@title = Sample content title
@body = Sample content body
@mediaSourceKey = sample-media-source-key

### Create a content draft.
### Copy response.contentId into @contentId before running review.http or query.http.
POST {{baseUrl}}/contents
Content-Type: application/json
Accept: application/json

{
  "title": "{{title}}",
  "body": "{{body}}",
  "mediaSourceKey": "{{mediaSourceKey}}"
}
