@baseUrl = http://localhost:8080
@contentId =
@title = Paid sample content title
@body = Paid sample content body
@mediaSourceKey = paid-sample-media-source-key

### Create a paid content draft.
### Copy response.contentId into @contentId before continuing with review.http or query.http.
POST {{baseUrl}}/advanced/contents/paid
Content-Type: application/json
Accept: application/json

{
  "title": "{{title}}",
  "body": "{{body}}",
  "mediaSourceKey": "{{mediaSourceKey}}"
}
